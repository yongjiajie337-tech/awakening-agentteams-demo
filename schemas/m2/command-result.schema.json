{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://awakening.local/schemas/m2/command-result.schema.json",
  "title": "M2 CommandResult",
  "type": "object",
  "additionalProperties": false,
  "required": ["command_id", "status", "reason_code", "result", "replayed"],
  "properties": {
    "command_id": {"type": "string", "format": "uuid"},
    "status": {"enum": ["COMMITTED", "REJECTED"]},
    "reason_code": {
      "enum": [
        "OK",
        "INVALID_ENVELOPE",
        "SCHEMA_INVALID",
        "IDENTITY_FIELD_FORBIDDEN",
        "COMMAND_NOT_REGISTERED",
        "PRINCIPAL_NOT_ALLOWED",
        "PROGRAM_SCOPE_DENIED",
        "NOT_FOUND",
        "VERSION_CONFLICT",
        "IDEMPOTENCY_KEY_REUSED",
        "STATE_TRANSITION_INVALID",
        "APPROVAL_REQUIRED",
        "APPROVAL_EXPIRED",
        "DECISION_INVALID",
        "DECISION_REPLAYED",
        "CONFLICT",
        "DATABASE_UNAVAILABLE",
        "TRANSACTION_ABORTED"
      ]
    },
    "state_version": {"type": "integer", "minimum": 0},
    "result": {"type": "object"},
    "replayed": {"type": "boolean"}
  }
}
