{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://awakening.local/schemas/m2/program.create.payload.schema.json",
  "title": "program.create payload",
  "type": "object",
  "additionalProperties": false,
  "required": ["plan", "auto_change_policy"],
  "properties": {
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_role", "duration_weeks", "core_project", "rubric", "tasks"],
      "properties": {
        "target_role": {"type": "string", "minLength": 1, "maxLength": 500},
        "duration_weeks": {"type": "integer", "minimum": 1, "maximum": 520},
        "core_project": {"type": "string", "minLength": 1, "maxLength": 2000},
        "rubric": {"type": "string", "minLength": 1, "maxLength": 4000},
        "tasks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["task_key", "title", "order"],
            "properties": {
              "task_key": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
              },
              "title": {"type": "string", "minLength": 1, "maxLength": 500},
              "order": {"type": "integer", "minimum": 0}
            }
          }
        }
      }
    },
    "auto_change_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allow_reorder_tasks"],
      "properties": {
        "allow_reorder_tasks": {"type": "boolean"}
      }
    }
  }
}
