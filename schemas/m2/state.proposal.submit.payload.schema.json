{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://awakening.local/schemas/m2/state.proposal.submit.payload.schema.json",
  "title": "state.proposal.submit payload",
  "type": "object",
  "additionalProperties": false,
  "required": ["change_type", "change"],
  "properties": {
    "change_type": {
      "enum": [
        "reorder_tasks",
        "change_target_role",
        "replace_core_project",
        "change_duration",
        "change_rubric",
        "restore_plan"
      ]
    },
    "change": {"type": "object"},
    "reason": {"type": "string", "minLength": 1, "maxLength": 2000}
  },
  "allOf": [
    {
      "if": {"properties": {"change_type": {"const": "reorder_tasks"}}},
      "then": {"properties": {"change": {"$ref": "#/$defs/reorderTasks"}}}
    },
    {
      "if": {"properties": {"change_type": {"const": "change_target_role"}}},
      "then": {"properties": {"change": {"$ref": "#/$defs/changeTargetRole"}}}
    },
    {
      "if": {"properties": {"change_type": {"const": "replace_core_project"}}},
      "then": {"properties": {"change": {"$ref": "#/$defs/replaceCoreProject"}}}
    },
    {
      "if": {"properties": {"change_type": {"const": "change_duration"}}},
      "then": {"properties": {"change": {"$ref": "#/$defs/changeDuration"}}}
    },
    {
      "if": {"properties": {"change_type": {"const": "change_rubric"}}},
      "then": {"properties": {"change": {"$ref": "#/$defs/changeRubric"}}}
    },
    {
      "if": {"properties": {"change_type": {"const": "restore_plan"}}},
      "then": {"properties": {"change": {"$ref": "#/$defs/restorePlan"}}}
    }
  ],
  "$defs": {
    "reorderTasks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_order"],
      "properties": {
        "task_order": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
          }
        }
      }
    },
    "changeTargetRole": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_role"],
      "properties": {
        "target_role": {"type": "string", "minLength": 1, "maxLength": 500}
      }
    },
    "replaceCoreProject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["core_project"],
      "properties": {
        "core_project": {"type": "string", "minLength": 1, "maxLength": 2000}
      }
    },
    "changeDuration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["duration_weeks"],
      "properties": {
        "duration_weeks": {"type": "integer", "minimum": 1, "maximum": 520}
      }
    },
    "changeRubric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rubric"],
      "properties": {
        "rubric": {"type": "string", "minLength": 1, "maxLength": 4000}
      }
    },
    "restorePlan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_plan_version_id"],
      "properties": {
        "target_plan_version_id": {"type": "string", "format": "uuid"}
      }
    }
  }
}
