{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://awakening.local/schemas/m4/skills/apply_authorized_change.input.schema.json",
  "title": "apply_authorized_change input",
  "type": "object",
  "additionalProperties": false,
  "required": ["proposal_id", "expected_state_version", "idempotency_key"],
  "properties": {
    "proposal_id": {"type": "string", "format": "uuid"},
    "expected_state_version": {"type": "integer", "minimum": 0},
    "idempotency_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "human_decision_id": {"type": "string", "format": "uuid"}
  }
}
