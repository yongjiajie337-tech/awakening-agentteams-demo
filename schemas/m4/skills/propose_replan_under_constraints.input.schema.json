{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://awakening.local/schemas/m4/skills/propose_replan_under_constraints.input.schema.json",
  "title": "propose_replan_under_constraints input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "program_id",
    "current_plan_id",
    "current_plan_version",
    "expected_state_version",
    "trigger",
    "constraints"
  ],
  "properties": {
    "program_id": {"$ref": "#/$defs/uuid"},
    "current_plan_id": {"$ref": "#/$defs/uuid"},
    "current_plan_version": {"type": "integer", "minimum": 1},
    "expected_state_version": {"type": "integer", "minimum": 0},
    "trigger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_kind", "source_ref", "summary"],
      "properties": {
        "source_kind": {"const": "synthetic_contract_fixture"},
        "source_ref": {"$ref": "#/$defs/uuid"},
        "summary": {"type": "string", "minLength": 1, "maxLength": 1000}
      }
    },
    "constraints": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["constraint_id", "category", "description", "immutable"],
        "properties": {
          "constraint_id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
          "category": {"enum": ["time", "resource", "safety", "dependency", "compliance"]},
          "description": {"type": "string", "minLength": 1, "maxLength": 1000},
          "immutable": {"const": true}
        }
      }
    }
  },
  "$defs": {
    "uuid": {"type": "string", "format": "uuid"}
  }
}
