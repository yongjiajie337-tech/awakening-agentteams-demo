{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://awakening.local/schemas/m4/skills/distill_experience_candidate.input.schema.json",
  "title": "distill_experience_candidate input",
  "type": "object",
  "additionalProperties": false,
  "required": ["program_id", "run_id", "trace_refs", "outcome", "error_refs"],
  "properties": {
    "program_id": {"$ref": "#/$defs/uuid"},
    "run_id": {"$ref": "#/$defs/uuid"},
    "trace_refs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/uuid"}
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "summary"],
      "properties": {
        "status": {"enum": ["completed", "partial", "failed"]},
        "summary": {"type": "string", "minLength": 1, "maxLength": 1000}
      }
    },
    "error_refs": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/uuid"}
    }
  },
  "$defs": {
    "uuid": {"type": "string", "format": "uuid"}
  }
}
