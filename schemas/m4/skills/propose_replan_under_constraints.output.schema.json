{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://awakening.local/schemas/m4/skills/propose_replan_under_constraints.output.schema.json",
  "title": "propose_replan_under_constraints output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "program_id",
    "source_plan_id",
    "source_plan_version",
    "based_on_state_version",
    "output_status",
    "candidates",
    "unresolved_constraints",
    "activation_allowed"
  ],
  "properties": {
    "program_id": {"$ref": "#/$defs/uuid"},
    "source_plan_id": {"$ref": "#/$defs/uuid"},
    "source_plan_version": {"type": "integer", "minimum": 1},
    "based_on_state_version": {"type": "integer", "minimum": 0},
    "output_status": {"const": "proposal_only"},
    "candidates": {
      "type": "array",
      "minItems": 2,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "candidate_id",
          "title",
          "rationale",
          "changes",
          "constraint_coverage",
          "requires_human_review",
          "activates_plan"
        ],
        "properties": {
          "candidate_id": {"$ref": "#/$defs/uuid"},
          "title": {"type": "string", "minLength": 1, "maxLength": 160},
          "rationale": {"type": "string", "minLength": 1, "maxLength": 1000},
          "changes": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["task_ref", "operation", "rationale"],
              "properties": {
                "task_ref": {"$ref": "#/$defs/uuid"},
                "operation": {"enum": ["reorder", "defer", "narrow_scope"]},
                "rationale": {"type": "string", "minLength": 1, "maxLength": 500}
              }
            }
          },
          "constraint_coverage": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"}
          },
          "requires_human_review": {"const": true},
          "activates_plan": {"const": false}
        }
      }
    },
    "unresolved_constraints": {
      "type": "array",
      "maxItems": 20,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"}
    },
    "activation_allowed": {"const": false}
  },
  "$defs": {
    "uuid": {"type": "string", "format": "uuid"}
  }
}
