{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://awakening.local/schemas/m4/skills/build_versioned_plan.output.schema.json",
  "title": "build_versioned_plan output",
  "type": "object",
  "additionalProperties": false,
  "required": ["proposal_type", "program_id", "base_state_version", "base_plan_version_id", "plan", "activation_allowed"],
  "properties": {
    "proposal_type": {"const": "plan_version"},
    "program_id": {"type": "string", "format": "uuid"},
    "base_state_version": {"type": "integer", "minimum": 0},
    "base_plan_version_id": {"type": "string", "format": "uuid"},
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project_candidate_id", "duration_weeks", "tasks"],
      "properties": {
        "project_candidate_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
        "duration_weeks": {"type": "integer", "minimum": 1, "maximum": 12},
        "tasks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {"$ref": "#/$defs/task"}
        }
      }
    },
    "activation_allowed": {"const": false}
  },
  "$defs": {
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_key", "title", "order", "depends_on"],
      "properties": {
        "task_key": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
        "title": {"type": "string", "minLength": 1, "maxLength": 500},
        "order": {"type": "integer", "minimum": 0, "maximum": 63},
        "depends_on": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"}
        }
      }
    }
  }
}
