{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://awakening.local/schemas/m4/skills/analyze_role_gap.input.schema.json",
  "title": "analyze_role_gap input",
  "type": "object",
  "additionalProperties": false,
  "required": ["program_id", "state_version", "role_facts", "user_facts", "constraints"],
  "properties": {
    "program_id": {"type": "string", "format": "uuid"},
    "state_version": {"type": "integer", "minimum": 0},
    "role_facts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_ref", "requirement"],
        "properties": {
          "source_ref": {
            "type": "string",
            "pattern": "^synthetic-role-source:[A-Za-z0-9._/-]{1,200}$"
          },
          "requirement": {"type": "string", "minLength": 1, "maxLength": 1000}
        }
      }
    },
    "user_facts": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["fact_id", "statement", "confirmed"],
        "properties": {
          "fact_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
          },
          "statement": {"type": "string", "minLength": 1, "maxLength": 1000},
          "confirmed": {"const": true}
        }
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["duration_weeks", "weekly_hours"],
      "properties": {
        "duration_weeks": {"type": "integer", "minimum": 1, "maximum": 12},
        "weekly_hours": {"type": "integer", "minimum": 1, "maximum": 40}
      }
    }
  }
}
