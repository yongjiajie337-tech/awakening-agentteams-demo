{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://awakening.local/schemas/m4/skills/design_evidence_project.output.schema.json",
  "title": "design_evidence_project output",
  "type": "object",
  "additionalProperties": false,
  "required": ["proposal_type", "program_id", "base_state_version", "candidates", "activation_allowed"],
  "properties": {
    "proposal_type": {"const": "project_candidates"},
    "program_id": {"type": "string", "format": "uuid"},
    "base_state_version": {"type": "integer", "minimum": 0},
    "candidates": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["candidate_id", "title", "gap_refs", "deliverables", "evidence_targets", "estimated_hours", "risk"],
        "properties": {
          "candidate_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
          "title": {"type": "string", "minLength": 1, "maxLength": 300},
          "gap_refs": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"}
          },
          "deliverables": {
            "type": "array",
            "minItems": 1,
            "maxItems": 12,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1, "maxLength": 300}
          },
          "evidence_targets": {
            "type": "array",
            "minItems": 1,
            "maxItems": 12,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1, "maxLength": 300}
          },
          "estimated_hours": {"type": "integer", "minimum": 1, "maximum": 480},
          "risk": {"enum": ["low", "medium", "high"]}
        }
      }
    },
    "activation_allowed": {"const": false}
  }
}
