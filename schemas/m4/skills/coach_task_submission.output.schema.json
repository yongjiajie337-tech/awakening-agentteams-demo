{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://awakening.local/schemas/m4/skills/coach_task_submission.output.schema.json",
  "title": "coach_task_submission output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "feedback_type",
    "program_id",
    "base_state_version",
    "task_id",
    "task_version",
    "criterion_observations",
    "missing_evidence",
    "revision_suggestion",
    "certifies_completion"
  ],
  "properties": {
    "feedback_type": {"const": "coach_feedback"},
    "program_id": {"type": "string", "format": "uuid"},
    "base_state_version": {"type": "integer", "minimum": 0},
    "task_id": {"type": "string", "format": "uuid"},
    "task_version": {"type": "integer", "minimum": 1},
    "criterion_observations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["criterion_id", "evidence_item_ids", "status", "reason"],
        "properties": {
          "criterion_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
          "evidence_item_ids": {
            "type": "array",
            "maxItems": 32,
            "uniqueItems": true,
            "items": {"type": "string", "format": "uuid"}
          },
          "status": {"enum": ["supported", "needs_more_evidence", "unable_to_determine"]},
          "reason": {"type": "string", "minLength": 1, "maxLength": 1000}
        }
      }
    },
    "missing_evidence": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 500}
    },
    "revision_suggestion": {"type": "string", "minLength": 1, "maxLength": 1000},
    "certifies_completion": {"const": false}
  }
}
