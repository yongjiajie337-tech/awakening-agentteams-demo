{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://awakening.local/schemas/m4/skills/review_evidence_against_rubric.input.schema.json",
  "title": "review_evidence_against_rubric input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "reviewer_mode",
    "package_kind",
    "package_id",
    "package_sha256",
    "context_sha256",
    "rubric_version",
    "criteria",
    "evidence_facts",
    "tools_allowed"
  ],
  "properties": {
    "reviewer_mode": {"const": "contract_smoke"},
    "package_kind": {"const": "fixed_synthetic_closed_package"},
    "package_id": {"type": "string", "format": "uuid"},
    "package_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "context_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "rubric_version": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
    "criteria": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["criterion_id", "statement"],
        "properties": {
          "criterion_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
          "statement": {"type": "string", "minLength": 1, "maxLength": 1000}
        }
      }
    },
    "evidence_facts": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["evidence_fact_id", "statement"],
        "properties": {
          "evidence_fact_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
          "statement": {"type": "string", "minLength": 1, "maxLength": 1000}
        }
      }
    },
    "tools_allowed": {"const": false}
  }
}
