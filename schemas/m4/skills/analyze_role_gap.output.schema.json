{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://awakening.local/schemas/m4/skills/analyze_role_gap.output.schema.json",
  "title": "analyze_role_gap output",
  "type": "object",
  "additionalProperties": false,
  "required": ["proposal_type", "program_id", "base_state_version", "gaps", "unable_to_determine"],
  "properties": {
    "proposal_type": {"const": "gap_assessment"},
    "program_id": {"type": "string", "format": "uuid"},
    "base_state_version": {"type": "integer", "minimum": 0},
    "gaps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["gap_id", "requirement", "current_evidence_fact_ids", "status", "reason"],
        "properties": {
          "gap_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
          },
          "requirement": {"type": "string", "minLength": 1, "maxLength": 1000},
          "current_evidence_fact_ids": {
            "type": "array",
            "maxItems": 32,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
            }
          },
          "status": {"enum": ["covered", "gap", "unable_to_determine"]},
          "reason": {"type": "string", "minLength": 1, "maxLength": 1000}
        }
      }
    },
    "unable_to_determine": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 500}
    }
  }
}
