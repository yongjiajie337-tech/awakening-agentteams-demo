{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://awakening.local/schemas/m4/skills/design_evidence_project.input.schema.json",
  "title": "design_evidence_project input",
  "type": "object",
  "additionalProperties": false,
  "required": ["program_id", "base_state_version", "gap_refs", "constraints", "allowed_tools", "rubric_ref"],
  "properties": {
    "program_id": {"type": "string", "format": "uuid"},
    "base_state_version": {"type": "integer", "minimum": 0},
    "gap_refs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"}
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["duration_weeks", "weekly_hours"],
      "properties": {
        "duration_weeks": {"type": "integer", "minimum": 1, "maximum": 12},
        "weekly_hours": {"type": "integer", "minimum": 1, "maximum": 40}
      }
    },
    "allowed_tools": {
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"}
    },
    "rubric_ref": {
      "type": "string",
      "pattern": "^synthetic-rubric:[A-Za-z0-9._-]{1,128}$"
    }
  }
}
