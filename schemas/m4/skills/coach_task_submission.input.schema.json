{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://awakening.local/schemas/m4/skills/coach_task_submission.input.schema.json",
  "title": "coach_task_submission input",
  "type": "object",
  "additionalProperties": false,
  "required": ["program_id", "state_version", "task", "criteria", "evidence_refs"],
  "properties": {
    "program_id": {"type": "string", "format": "uuid"},
    "state_version": {"type": "integer", "minimum": 0},
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_id", "task_version", "title"],
      "properties": {
        "task_id": {"type": "string", "format": "uuid"},
        "task_version": {"type": "integer", "minimum": 1},
        "title": {"type": "string", "minLength": 1, "maxLength": 500}
      }
    },
    "criteria": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["criterion_id", "statement"],
        "properties": {
          "criterion_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
          "statement": {"type": "string", "minLength": 1, "maxLength": 1000}
        }
      }
    },
    "evidence_refs": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["evidence_item_id", "object_ref_sha256"],
        "properties": {
          "evidence_item_id": {"type": "string", "format": "uuid"},
          "object_ref_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    }
  }
}
